    "@vueuse/router": "^10.11.1",
    "axios": "^1.15.2",
    "es-toolkit": "^1.46.1",
    "pinia": "^3.0.4",
    "tippy.js": "^6.3.7",
    "vue": "^3.5.33",
    "vue-datepicker-next": "^1.0.3",
    "vue-router": "^4.6.4"
  },
  "prettier": {
    "arrowParens": "always",
    "bracketSpacing": true,

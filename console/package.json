    "@rsbuild/plugin-sass": "^1.5.2",
    "@rushstack/eslint-patch": "^1.16.1",
    "@tsconfig/node20": "^20.1.9",
    "@types/node": "^20.19.39",
    "@unocss/eslint-config": "^66.6.8",
    "@unocss/webpack": "^66.6.8",
    "@vue/eslint-config-prettier": "^7.1.0",
    "@vue/eslint-config-typescript": "^10.0.0",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^8.57.1",
